<Window x:Class="WeightBridgeApp.TransactionTypeLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction Type Lookup" Height="380" Width="740"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Transaction Type Lookup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Type" FontWeight="SemiBold" />
                <TextBox x:Name="TypeFilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="28" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Description" FontWeight="SemiBold" />
                <TextBox x:Name="DescriptionFilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="28" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Form" FontWeight="SemiBold" />
                <TextBox x:Name="FormFilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="28" />
            </StackPanel>
        </Grid>
        <DataGrid x:Name="LookupDataGrid" Grid.Row="2" ItemsSource="{Binding LookupRows}" SelectedItem="{Binding SelectedTransactionType, Mode=TwoWay}" MouseDoubleClick="LookupDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="180" />
                <DataGridTextColumn Header="Form" Binding="{Binding Form}" Width="240" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#202A44" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Select" Width="90" Margin="0,0,8,0" Click="SelectButton_Click" />
                <Button Content="Cancel" Width="90" Click="CancelButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
