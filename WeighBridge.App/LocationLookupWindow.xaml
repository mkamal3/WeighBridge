<Window x:Class="WeightBridgeApp.LocationLookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Location Lookup" Height="430" Width="720"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="Location Lookup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Location Code" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="CodeFilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="30" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Location Name" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="NameFilterTextBox" TextChanged="FilterTextBox_TextChanged" Height="30" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="LookupDataGrid" Grid.Row="2" ItemsSource="{Binding LookupRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="LookupDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Location Code" Binding="{Binding LocationCode}" Width="160" />
                <DataGridTextColumn Header="Location Name" Binding="{Binding LocationName}" Width="260" />
                <DataGridTextColumn Header="Location Type" Binding="{Binding LocationType}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select" Width="90" Margin="0,0,8,0" Click="SelectButton_Click" />
                <Button Content="Cancel" Width="90" Click="CancelButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
