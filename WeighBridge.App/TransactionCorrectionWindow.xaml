<Window x:Class="WeightBridgeApp.TransactionCorrectionWindow"
        x:Name="CorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction Correction" Height="820" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F6F8FC" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Transaction Correction" FontSize="22" FontWeight="SemiBold" Foreground="#202A44" />
                    <TextBlock Text="Correct completed transactions through a controlled approval workflow. Original values are retained in correction history." Foreground="#6B7280" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Correction.CorrectionNumber}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Correction.Status, StringFormat=Status: {0}}" Foreground="#6B7280" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Original Slip" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OriginalWeighment.SlipNumber}" IsReadOnly="True" Background="#F2F4F7" />
                <Label Grid.Row="0" Grid.Column="2" Content="Correction Type *" />
                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding CorrectionTypes}" SelectedItem="{Binding Correction.CorrectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDraftEditable}" />
                <Label Grid.Row="0" Grid.Column="4" Content="Reason *" />
                <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding CorrectionReasons}" DisplayMemberPath="DisplayText" SelectedValuePath="Code" SelectedValue="{Binding Correction.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDraftEditable}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Current Version" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OriginalWeighment.CorrectionVersion}" IsReadOnly="True" Background="#F2F4F7" />
                <Label Grid.Row="1" Grid.Column="2" Content="Submitted By" />
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Correction.SubmittedBy}" IsReadOnly="True" Background="#F2F4F7" />
                <Label Grid.Row="1" Grid.Column="4" Content="Submitted Date/Time" />
                <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Correction.SubmittedDateTime}" IsReadOnly="True" Background="#F2F4F7" />

                <Label Grid.Row="2" Grid.Column="0" Content="Comment *" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding Correction.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Height="58" AcceptsReturn="True" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Header Correction">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Original Value" FontWeight="SemiBold" Foreground="#6B7280" Margin="4,4,4,8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Corrected Value" FontWeight="SemiBold" Foreground="#202A44" Margin="4,4,4,8" />

                        <Label Grid.Row="1" Grid.Column="0" Content="Legal Entity" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OriginalWeighment.DataAreaId}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CorrectedWeighment.DataAreaId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="#F2F4F7" ToolTip="Legal Entity cannot be changed through correction." />

                        <Label Grid.Row="2" Grid.Column="0" Content="Vehicle No" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OriginalWeighment.VehicleNo}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding CorrectedWeighment.VehicleNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" />

                        <Label Grid.Row="3" Grid.Column="0" Content="Driver Name" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OriginalWeighment.DriverName}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding CorrectedWeighment.DriverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" />


                        <Label Grid.Row="4" Grid.Column="0" Content="First Weight" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OriginalWeighment.FirstWeight}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CorrectedFirstWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsWeightReadOnly}" />

                        <Label Grid.Row="5" Grid.Column="0" Content="Second Weight" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OriginalWeighment.SecondWeight}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding CorrectedSecondWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsReadOnly="{Binding IsWeightReadOnly}" />

                        <Label Grid.Row="6" Grid.Column="0" Content="Net Weight" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OriginalWeighment.NetWeight}" IsReadOnly="True" Background="#F2F4F7" />
                        <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding CorrectedNetWeight, Mode=OneWay}" IsReadOnly="True" Background="#F2F4F7" ToolTip="Automatically recalculated from corrected First and Second Weight." />

                        <Label Grid.Row="7" Grid.Column="0" Content="Remarks" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding OriginalWeighment.Remarks}" IsReadOnly="True" Background="#F2F4F7" Height="72" TextWrapping="Wrap" AcceptsReturn="True" />
                        <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding CorrectedWeighment.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Height="72" TextWrapping="Wrap" AcceptsReturn="True" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Material Line Correction">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Original material lines are retained in audit history. Use Add, Modify/Replace, or Remove." VerticalAlignment="Center" Foreground="#6B7280" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add Line" Width="105" Click="AddLine_Click" IsEnabled="{Binding IsDraftEditable}" />
                            <Button Content="Remove Added Line" Width="145" Click="RemoveAddedLine_Click" IsEnabled="{Binding IsDraftEditable}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MaterialLineEdits}" SelectedItem="{Binding SelectedMaterialLineEdit, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="{Binding IsFormReadOnly}" CanUserAddRows="False" FrozenColumnCount="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line" Binding="{Binding LineNo}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Original Item" Binding="{Binding OriginalItemNumber}" Width="115" IsReadOnly="True" />
                            <DataGridTextColumn Header="Original UOM" Binding="{Binding OriginalUom}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Original Qty" Binding="{Binding OriginalExpectedQty}" Width="95" IsReadOnly="True" />
                            <DataGridTextColumn Header="Original Remarks" Binding="{Binding OriginalRemarks}" Width="150" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Action" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.LineActionTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Corrected Item" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ItemMasters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="ItemNumber" SelectedValuePath="ItemNumber"
                                                  SelectedValue="{Binding CorrectedItemNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="MaterialItem_SelectionChanged"
                                                  IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Corrected Item Name" Binding="{Binding CorrectedItemName}" Width="170" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Corrected UOM" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.UomSymbols, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding CorrectedUom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Corrected Qty" Binding="{Binding CorrectedExpectedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="Corrected Remarks" Binding="{Binding CorrectedRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Workflow / Audit">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="Status" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Correction.Status}" IsReadOnly="True" Background="#F2F4F7" />
                    <Label Grid.Row="1" Grid.Column="0" Content="Submitted By" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Correction.SubmittedBy}" IsReadOnly="True" Background="#F2F4F7" />
                    <Label Grid.Row="2" Grid.Column="0" Content="Submitted Date/Time" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Correction.SubmittedDateTime}" IsReadOnly="True" Background="#F2F4F7" />
                    <Label Grid.Row="3" Grid.Column="0" Content="Approved/Rejected By" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Correction.ApprovedRejectedBy}" IsReadOnly="True" Background="#F2F4F7" />
                    <Label Grid.Row="4" Grid.Column="0" Content="Approval/Rejection Date" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Correction.ApprovalRejectedDateTime}" IsReadOnly="True" Background="#F2F4F7" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#DDE3EF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#202A44" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Save Draft" Width="105" Click="SaveDraft_Click" IsEnabled="{Binding CanSaveDraft}" />
                    <Button Content="Submit" Width="95" Click="Submit_Click" IsEnabled="{Binding CanSubmit}" Style="{StaticResource PrimaryActionButtonStyle}" />
                    <Button Content="Approve" Width="95" Click="Approve_Click" IsEnabled="{Binding CanApprove}" Style="{StaticResource ApproveActionButtonStyle}" />
                    <Button Content="Reject" Width="95" Click="Reject_Click" IsEnabled="{Binding CanReject}" Style="{StaticResource RejectActionButtonStyle}" />
                    <Button Content="Close" Width="95" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
