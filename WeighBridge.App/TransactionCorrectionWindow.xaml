<Window x:Class="WeightBridgeApp.TransactionCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correct Transaction" Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Correct Transaction" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Update the transaction fields and click Save." Foreground="Gray" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Ticket No" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TicketNo}" IsReadOnly="True" Background="#EFEFEF" />

                <Label Grid.Row="1" Grid.Column="0" Content="Status" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Status}" IsReadOnly="True" Background="#EFEFEF" />

                <Label Grid.Row="2" Grid.Column="0" Content="Company" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="3" Grid.Column="0" Content="Vehicle No *" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VehicleNo, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="4" Grid.Column="0" Content="Driver Name *" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="5" Grid.Column="0" Content="Party Type *" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PartyType, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="6" Grid.Column="0" Content="Party Account" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PartyAccount, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="7" Grid.Column="0" Content="Party Name *" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="8" Grid.Column="0" Content="Item Number *" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding ItemNumber, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="9" Grid.Column="0" Content="Item Name *" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="10" Grid.Column="0" Content="First Weight" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding FirstWeight, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="11" Grid.Column="0" Content="Second Weight" />
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding SecondWeight, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />

                <Label Grid.Row="12" Grid.Column="0" Content="First Weight By" />
                <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding FirstWeightBy, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="13" Grid.Column="0" Content="Second Weight By" />
                <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding SecondWeightBy, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="14" Grid.Column="0" Content="Remarks" />
                <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Height="32" Margin="0,0,8,0" Click="Save_Click" />
            <Button Content="Cancel" Width="90" Height="32" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
