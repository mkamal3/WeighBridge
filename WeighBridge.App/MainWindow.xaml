                                <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType}" Width="90" />
                                <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="120" />
                                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="160" />
                                <DataGridTextColumn Header="First Weight" Binding="{Binding FirstWeight}" Width="100" />
                                <DataGridTextColumn Header="First Time" Binding="{Binding FirstWeightTime}" Width="150" />
                                <DataGridTextColumn Header="First Weight By" Binding="{Binding FirstWeightBy}" Width="130" />
                                <DataGridTextColumn Header="Second Weight" Binding="{Binding SecondWeight}" Width="105" />
                                <DataGridTextColumn Header="Second Time" Binding="{Binding SecondWeightTime}" Width="150" />
                                <DataGridTextColumn Header="Second Weight By" Binding="{Binding SecondWeightBy}" Width="140" />
                                <DataGridTextColumn Header="Net" Binding="{Binding NetWeight}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="User Management" Visibility="{Binding CanAccessUserManagement, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding UserFormModeText}" FontSize="18" FontWeight="SemiBold" />
                                <Label Content="Username" />
                                <TextBox Text="{Binding UserUsername, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Content="Full Name" />
                                <TextBox Text="{Binding UserFullName, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Content="Company *" />
                                <TextBox Text="{Binding UserCompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                <Label Content="Password" />
                                <TextBox Text="{Binding UserPassword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Required for new user. Leave blank while editing if password should not change." />
                                <CheckBox Content="Active" IsChecked="{Binding UserIsActive}" Margin="4,12,4,4" />

                                <TextBlock Text="Screen Access" FontWeight="SemiBold" Margin="4,14,4,6" />
                                <CheckBox Content="Weighment" IsChecked="{Binding UserCanAccessWeighment}" Margin="4" />
                                <CheckBox Content="Settings" IsChecked="{Binding UserCanAccessSettings}" Margin="4" />
                                <CheckBox Content="Masters" IsChecked="{Binding UserCanAccessMasters}" Margin="4" />
                                <CheckBox Content="Reports" IsChecked="{Binding UserCanAccessReports}" Margin="4" />
                                <CheckBox Content="User Management" IsChecked="{Binding UserCanAccessUserManagement}" Margin="4" />

                                <TextBlock Text="Completed Transaction Permission" FontWeight="SemiBold" Margin="4,14,4,6" />
                                <CheckBox Content="Can Edit Completed Transaction" IsChecked="{Binding UserCanEditCompletedTransaction}" Margin="4" />
                                <CheckBox Content="Can Delete Completed Transaction" IsChecked="{Binding UserCanDeleteCompletedTransaction}" Margin="4" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Save User" Command="{Binding SaveUserCommand}" />
                                    <Button Content="Clear" Command="{Binding ClearUserFormCommand}" />
                                    <Button Content="Refresh" Command="{Binding RefreshUsersCommand}" />
                                </WrapPanel>
                                <TextBlock Text="Note: company is mandatory. Select a user from the right grid to edit. Leave password blank to keep the same password." Foreground="Gray" TextWrapping="Wrap" Margin="4,14,4,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Users" FontSize="18" FontWeight="SemiBold" />
                            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="110" />
                                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="150" />
                                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="140" />
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65" />
                                    <DataGridCheckBoxColumn Header="Weighment" Binding="{Binding CanAccessWeighment}" Width="85" />
                                    <DataGridCheckBoxColumn Header="Settings" Binding="{Binding CanAccessSettings}" Width="75" />
                                    <DataGridCheckBoxColumn Header="Masters" Binding="{Binding CanAccessMasters}" Width="75" />
                                    <DataGridCheckBoxColumn Header="Reports" Binding="{Binding CanAccessReports}" Width="75" />
                                    <DataGridCheckBoxColumn Header="Users" Binding="{Binding CanAccessUserManagement}" Width="65" />
                                    <DataGridCheckBoxColumn Header="Edit Completed" Binding="{Binding CanEditCompletedTransaction}" Width="110" />
                                    <DataGridCheckBoxColumn Header="Delete Completed" Binding="{Binding CanDeleteCompletedTransaction}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
