                                            <Button Content="Correction" Command="{Binding CorrectTransactionCommand}" Visibility="{Binding CanAccessCorrection, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding CanCorrectSelectedTransaction}" MinWidth="105" Height="32" Margin="0,0,8,0" />
                                            <Button Content="Cancellation / Void" Command="{Binding StartCancellationFromTransactionCommand}" Visibility="{Binding CanCreateCancellationVoidRequest, Converter={StaticResource BoolToVisibilityConverter}}" IsEnabled="{Binding CanInitiateCancellationFromTransaction}" MinWidth="135" Height="32" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Transaction Review" FontSize="19" FontWeight="SemiBold" Foreground="#202A44" />
                                            <TextBlock Text="Read-only inquiry. Transaction-specific fields are loaded dynamically from the mapped form." Foreground="#667085" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="#F6F8FC" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SelectedTransactionWeighment.SlipNumber, TargetNullValue='Select a transaction'}" FontSize="17" FontWeight="SemiBold" Foreground="#202A44" />
                                                <TextBlock Text="{Binding SelectedTransactionReviewForm, StringFormat=Mapped Form: {0}}" Foreground="#667085" Margin="0,2,0,0" />
                                            </StackPanel>
