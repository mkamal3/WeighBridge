                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Company" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportCompanyFilter, UpdateSourceTrigger=PropertyChanged}" Width="135" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Vehicle" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportVehicleFilter, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Driver" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportDriverFilter, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Party" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportPartyFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Party Type" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportPartyTypeFilter, UpdateSourceTrigger=PropertyChanged}" Width="115" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Item" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportItemFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ReportStatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="30" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                        <Button Content="Apply" Command="{Binding LoadReportCommand}" MinWidth="95" Height="34" Margin="0,0,8,0" />
                                        <Button Content="Clear" Command="{Binding ClearReportFiltersCommand}" MinWidth="95" Height="34" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                        <DataGrid ItemsSource="{Binding FilteredReportRows}" SelectedItem="{Binding SelectedReportWeighment}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
                                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="110" />
                                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="120" />
                                <DataGridTextColumn Header="Party Account" Binding="{Binding PartyAccount}" Width="120" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="160" />
                                <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType}" Width="90" />
                                <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="120" />
