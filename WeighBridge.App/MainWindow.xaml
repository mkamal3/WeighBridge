<Window x:Class="WeightBridgeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BridgeOne" Height="800" Width="1240"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202A44" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="BridgeOne" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="User: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Company: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserCompany}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Connection: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EF" BorderThickness="0,0,0,1" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" Foreground="#202A44" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
        </Border>

        <TabControl Grid.Row="2" Margin="10,6,10,10">
            <TabItem Header="Weighment" Visibility="{Binding CanAccessWeighment, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="White" CornerRadius="8" Padding="14" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="Live Weight" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LiveWeightText}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Stable: " FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StableText}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LiveRaw}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="8" Padding="14" Margin="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Weighment Entry" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <Label Grid.Row="1" Grid.Column="0" Content="Ticket No" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TicketNo}" IsReadOnly="True" Background="#EFEFEF" />

                                    <Label Grid.Row="2" Grid.Column="0" Content="Company *" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentUserCompany, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />

                                    <Label Grid.Row="3" Grid.Column="0" Content="Vehicle No" />
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding Vehicles}"
                                              DisplayMemberPath="VehicleNo"
                                              Text="{Binding VehicleNo, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />

                                    <Label Grid.Row="4" Grid.Column="0" Content="Driver Name" />
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding Drivers}"
                                              DisplayMemberPath="DriverName"
                                              Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />

                                    <Label Grid.Row="5" Grid.Column="0" Content="Party Type" />
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding PartyTypes}"
                                              SelectedItem="{Binding SelectedPartyType}" />

                                    <Label Grid.Row="6" Grid.Column="0" Content="Party" />
                                    <ComboBox Grid.Row="6" Grid.Column="1"
                                              ItemsSource="{Binding FilteredParties}"
                                              SelectedItem="{Binding SelectedWeighmentParty}"
                                              DisplayMemberPath="PartyDisplay"
                                              TextSearch.TextPath="PartyDisplay"
                                              Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />

                                    <Label Grid.Row="7" Grid.Column="0" Content="Item" />
                                    <ComboBox Grid.Row="7" Grid.Column="1"
                                              ItemsSource="{Binding ItemMasters}"
                                              SelectedItem="{Binding SelectedWeighmentItem}"
                                              DisplayMemberPath="ProductName"
                                              TextSearch.TextPath="ProductName"
                                              Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" />

                                    <Label Grid.Row="8" Grid.Column="0" Content="Remarks" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                        <UniformGrid Columns="3">
                                            <StackPanel>
                                                <TextBlock Text="First Weight" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FirstWeightText}" FontSize="18" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Second Weight" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SecondWeightText}" FontSize="18" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Net Weight" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding NetWeightText}" FontSize="18" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Save First Weight" Command="{Binding SaveFirstWeightCommand}" IsEnabled="{Binding CanSaveFirstWeight}" />
                                            <Button Content="Save Second Weight" Command="{Binding SaveSecondWeightCommand}" IsEnabled="{Binding CanSaveSecondWeight}" />
                                            <Button Content="Clear" Command="{Binding ClearCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="Open Tickets" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="Load Selected" Command="{Binding LoadOpenTicketCommand}" />
                                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding OpenWeighments}" SelectedItem="{Binding SelectedOpenWeighment}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" Width="120" />
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
                                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="100" />
                                        <DataGridTextColumn Header="Party Account" Binding="{Binding PartyAccount}" Width="120" />
                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="150" />
                                        <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType}" Width="90" />
                                        <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="120" />
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="150" />
                                        <DataGridTextColumn Header="First Weight" Binding="{Binding FirstWeight}" Width="100" />
                                        <DataGridTextColumn Header="First Time" Binding="{Binding FirstWeightTime}" Width="150" />
                                        <DataGridTextColumn Header="First Weight By" Binding="{Binding FirstWeightBy}" Width="130" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <TextBlock Text="Completed Today" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="Save Selected Edit" Command="{Binding SaveCompletedEditCommand}" Visibility="{Binding CanEditCompletedTransaction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="Delete Selected" Command="{Binding DeleteCompletedCommand}" Visibility="{Binding CanDeleteCompletedTransaction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding CompletedToday}" SelectedItem="{Binding SelectedCompletedWeighment}" IsReadOnly="{Binding IsCompletedGridReadOnly}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
                                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="100" />
                                        <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="100" />
                                        <DataGridTextColumn Header="Party Account" Binding="{Binding PartyAccount}" Width="120" />
                                        <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="150" />
                                        <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType}" Width="90" />
                                        <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="120" />
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="150" />
                                        <DataGridTextColumn Header="First Weight" Binding="{Binding FirstWeight}" Width="100" />
                                        <DataGridTextColumn Header="First Weight By" Binding="{Binding FirstWeightBy}" Width="130" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Second Weight" Binding="{Binding SecondWeight}" Width="105" />
                                        <DataGridTextColumn Header="Second Weight By" Binding="{Binding SecondWeightBy}" Width="140" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Net" Binding="{Binding NetWeight}" Width="75" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="12" Width="620" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Device Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <Label Grid.Row="1" Grid.Column="0" Content="Connection Type" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding Settings.ConnectionType}" />
                            <Label Grid.Row="2" Grid.Column="0" Content="COM Port" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.ComPort, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="3" Grid.Column="0" Content="Baud Rate" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.BaudRate, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="4" Grid.Column="0" Content="Parity" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Settings.Parity}" />
                            <Label Grid.Row="5" Grid.Column="0" Content="Data Bits" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.DataBits, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="6" Grid.Column="0" Content="Stop Bits" />
                            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding Settings.StopBits}" />
                            <Label Grid.Row="7" Grid.Column="0" Content="TCP IP / Port" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Text="{Binding Settings.IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                <TextBox Text="{Binding Settings.TcpPort, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            </StackPanel>
                            <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                                <TextBlock Text="Use Mock first to test without device." VerticalAlignment="Center" Foreground="Gray" Margin="8,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Masters" Visibility="{Binding CanAccessMasters, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl Margin="12">
                        <TabItem Header="Customer Master">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="View of &quot;All Customers&quot;" FontSize="18" FontWeight="SemiBold" Margin="4" />
                                        <WrapPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Account No" />
                                                <TextBox Text="{Binding CustomerAccountFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="220" Margin="0,0,8,6">
                                                <TextBlock Text="Name" />
                                                <TextBox Text="{Binding CustomerNameFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Customer Group" />
                                                <TextBox Text="{Binding CustomerGroupFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Account Status" />
                                                <TextBox Text="{Binding CustomerStatusFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </WrapPanel>
                            <DataGrid ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}" VerticalAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Customer Account" Binding="{Binding CustomerAccount}" Width="130" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Method of Payment" Binding="{Binding MethodOfPayment}" Width="130" />
                                    <DataGridTextColumn Header="Terms of Payment" Binding="{Binding TermsOfPayment}" Width="130" />
                                    <DataGridTextColumn Header="Delivery Terms" Binding="{Binding DeliveryTerms}" Width="120" />
                                    <DataGridTextColumn Header="Account Status" Binding="{Binding AccountStatus}" Width="120" />
                                    <DataGridTextColumn Header="Account Status Reason" Binding="{Binding AccountStatusReason}" Width="160" />
                                    <DataGridTextColumn Header="Customer Group" Binding="{Binding CustomerGroup}" Width="120" />
                                    <DataGridTextColumn Header="Employee Responsible" Binding="{Binding EmployeeResponsible}" Width="160" />
                                    <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90" />
                                    <DataGridTextColumn Header="Telephone" Binding="{Binding Telephone}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Open / Edit Record" FontSize="18" FontWeight="SemiBold" Margin="4" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                                    <Button Content="Save" Command="{Binding SaveCustomerCommand}" />
                                    <Button Content="New / Clear" Command="{Binding ClearCustomerFormCommand}" />
                                    <TextBlock Text="Select a row from left side to open/edit record." VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0" />
                                </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                    <GroupBox Header="General" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Account *" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.CustomerAccount, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Organization/Person" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.OrganizationPerson, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Name *" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Search Name" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.SearchName, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Customer Group" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.CustomerGroup, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Classification group" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ClassificationGroup, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Address" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Name or Description" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.AddressNameDescription, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Address" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.Address, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Purpose" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.AddressPurpose, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Contact Information" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Description" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ContactDescription, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Type" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ContactType, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Contact Number/Address" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ContactNumberAddress, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Extension" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ContactExtension, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Payment Defaults" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Terms of Payment" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.TermsOfPayment, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Method of Payment" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.MethodOfPayment, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Invoice and Delivery" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Invoice Account" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.InvoiceAccount, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Delivery Terms" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.DeliveryTerms, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Mode of Delivery" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.ModeOfDelivery, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Sales Tax Group" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.SalesTaxGroup, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Status / Other" Margin="4" Padding="8">
                                        <StackPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Account Status" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.AccountStatus, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Account Status Reason" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.AccountStatusReason, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Employee Responsible" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.EmployeeResponsible, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Currency" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.Currency, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <Label Content="Telephone" Width="190" />
                                                <TextBox Text="{Binding CustomerForm.Telephone, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Vendor Master">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="View of &quot;All Vendors&quot;" FontSize="18" FontWeight="SemiBold" Margin="4" />
                                        <WrapPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Vendor Account" />
                                                <TextBox Text="{Binding VendorAccountFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="220" Margin="0,0,8,6">
                                                <TextBlock Text="Name" />
                                                <TextBox Text="{Binding VendorNameFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Vendor Group" />
                                                <TextBox Text="{Binding VendorGroupFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,8,6">
                                                <TextBlock Text="Account Status" />
                                                <TextBox Text="{Binding VendorStatusFilter, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </WrapPanel>
                            <DataGrid ItemsSource="{Binding FilteredVendors}" SelectedItem="{Binding SelectedVendor}" VerticalAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vendor Account" Binding="{Binding VendorAccount}" Width="130" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Method of Payment" Binding="{Binding MethodOfPayment}" Width="130" />
                                    <DataGridTextColumn Header="Terms of Payment" Binding="{Binding TermsOfPayment}" Width="130" />
                                    <DataGridTextColumn Header="Delivery Terms" Binding="{Binding DeliveryTerms}" Width="120" />
                                    <DataGridTextColumn Header="Account Status" Binding="{Binding AccountStatus}" Width="120" />
                                    <DataGridTextColumn Header="Account Status Reason" Binding="{Binding AccountStatusReason}" Width="160" />
                                    <DataGridTextColumn Header="Vendor Group" Binding="{Binding VendorGroup}" Width="120" />
                                    <DataGridTextColumn Header="Employee Responsible" Binding="{Binding EmployeeResponsible}" Width="160" />
                                    <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="90" />
