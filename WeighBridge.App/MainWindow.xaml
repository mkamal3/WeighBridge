                                    <TextBlock Text="To Date" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <DatePicker SelectedDate="{Binding TransactionTo}" SelectedDateFormat="Short" Language="en-GB" Width="155" Height="30" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Slip Number" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TransactionTicketFilter, UpdateSourceTrigger=PropertyChanged}" Width="145" Height="30" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
