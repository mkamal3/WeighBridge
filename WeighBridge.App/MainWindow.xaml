                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredTransactionRows}" SelectedItem="{Binding SelectedTransactionWeighment, Mode=TwoWay}" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Slip Number" Binding="{Binding SlipNumber}" Width="155" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="145" />
                                        <DataGridTextColumn Header="Date/Time" Binding="{Binding TransactionDateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="145" />
                                        <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="105" />
                                        <DataGridTextColumn Header="Net" Binding="{Binding NetWeight}" Width="85" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="4" BorderBrush="#E2E7F0" BorderThickness="1">
