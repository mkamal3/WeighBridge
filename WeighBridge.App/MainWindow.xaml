                                        <DataGrid ItemsSource="{Binding TransactionReviewDynamicFields}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="300">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Field" Binding="{Binding Label}" Width="210" />
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>

                                    <GroupBox Header="Material Lines" Padding="6" Margin="0,0,0,4">
                                        <DataGrid ItemsSource="{Binding TransactionReviewMaterialLines}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="260">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Line" Binding="{Binding LineNo}" Width="55" />
