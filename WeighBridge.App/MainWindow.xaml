                        </TabItem>

                        <TabItem Header="Operator Master">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" Margin="4">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Top" Text="View of &quot;Operator Master&quot;" FontSize="18" FontWeight="SemiBold" Margin="4" />
                                        <WrapPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                                            <StackPanel Width="130" Margin="0,0,8,6"><TextBlock Text="Employee ID" /><TextBox Text="{Binding OperatorIdFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="170" Margin="0,0,8,6"><TextBlock Text="Operator Name" /><TextBox Text="{Binding OperatorNameFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="130" Margin="0,0,8,6"><TextBlock Text="Username" /><TextBox Text="{Binding OperatorUsernameFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="140" Margin="0,0,8,6"><TextBlock Text="Designation" /><TextBox Text="{Binding OperatorDesignationFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="140" Margin="0,0,8,6"><TextBlock Text="Department" /><TextBox Text="{Binding OperatorDepartmentFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="150" Margin="0,0,8,6"><TextBlock Text="Weighbridge" /><TextBox Text="{Binding OperatorWeighbridgeFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                            <StackPanel Width="120" Margin="0,0,8,6"><TextBlock Text="Status" /><TextBox Text="{Binding OperatorStatusFilter, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        </WrapPanel>
                                        <DataGrid ItemsSource="{Binding FilteredOperatorMasters}" SelectedItem="{Binding SelectedOperatorMaster}" VerticalAlignment="Stretch" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Operator ID" Binding="{Binding OperatorId}" Width="90" />
                                                <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="120" />
                                                <DataGridTextColumn Header="Operator Name" Binding="{Binding OperatorName}" Width="170" />
                                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                                                <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="150" />
                                                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="140" />
                                                <DataGridTextColumn Header="Default Weighbridge" Binding="{Binding DefaultWeighbridge}" Width="160" />
                                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Open / Edit Operator" FontSize="18" FontWeight="SemiBold" Margin="4" />
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                                            <Button Content="Save" Command="{Binding SaveOperatorMasterCommand}" />
                                            <Button Content="New / Clear" Command="{Binding ClearOperatorMasterFormCommand}" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <GroupBox Header="General" Margin="4" Padding="8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Operator ID" Width="205" /><TextBox Text="{Binding OperatorMasterForm.OperatorId, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Employee ID *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.EmployeeId, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Operator Name *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.OperatorName, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Username *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.Username, UpdateSourceTrigger=PropertyChanged}" ToolTip="Unique login username for this operator." /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Password" Width="205" /><TextBox Text="{Binding OperatorMasterForm.Password, UpdateSourceTrigger=PropertyChanged}" ToolTip="Required for new operator. Leave blank while editing if password should not change." /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Confirm Password" Width="205" /><TextBox Text="{Binding OperatorMasterForm.ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" ToolTip="Required when entering/changing password." /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Email *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.Email, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Mobile Number" Width="205" /><TextBox Text="{Binding OperatorMasterForm.MobileNumber, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Header="Organization" Margin="4" Padding="8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Designation *" Width="205" /><ComboBox IsEditable="True" Text="{Binding OperatorMasterForm.Designation, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Weighbridge Operator" /><ComboBoxItem Content="Supervisor" /><ComboBoxItem Content="QC Inspector" /><ComboBoxItem Content="Administrator" /><ComboBoxItem Content="Cashier" /><ComboBoxItem Content="Manager" /></ComboBox></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Department *" Width="205" /><ComboBox IsEditable="True" Text="{Binding OperatorMasterForm.Department, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Operations" /><ComboBoxItem Content="Production" /><ComboBoxItem Content="Warehouse" /><ComboBoxItem Content="Quality" /><ComboBoxItem Content="Finance" /><ComboBoxItem Content="IT" /><ComboBoxItem Content="Administration" /></ComboBox></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Legal Entity *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.DataAreaId, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Header="Weighbridge Assignment" Margin="4" Padding="8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Default Weighbridge" Width="205" /><TextBox Text="{Binding OperatorMasterForm.DefaultWeighbridge, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Assigned Weighbridges *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.AssignedWeighbridges, UpdateSourceTrigger=PropertyChanged}" ToolTip="Multi-select values can be separated by comma." /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Default Shift" Width="205" /><TextBox Text="{Binding OperatorMasterForm.DefaultShift, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Header="Role / Permissions" Margin="4" Padding="8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Role *" Width="205" /><ComboBox IsEditable="True" Text="{Binding OperatorMasterForm.Role, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Operator" /><ComboBoxItem Content="Supervisor" /><ComboBoxItem Content="Administrator" /><ComboBoxItem Content="QC Inspector" /><ComboBoxItem Content="Cashier" /></ComboBox></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Permission Profile *" Width="205" /><TextBox Text="{Binding OperatorMasterForm.PermissionProfile, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <TextBlock Text="Screen Access" FontWeight="SemiBold" Margin="205,10,0,4" />
                                                        <CheckBox Content="Can Access Weighment" IsChecked="{Binding OperatorMasterForm.CanAccessWeighment}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Access Masters" IsChecked="{Binding OperatorMasterForm.CanAccessMasters}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Access Reports" IsChecked="{Binding OperatorMasterForm.CanAccessReports}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Access Transactions" IsChecked="{Binding OperatorMasterForm.CanAccessTransactions}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Access Settings" IsChecked="{Binding OperatorMasterForm.CanAccessSettings}" Margin="205,4,0,0" />
                                                        <TextBlock Text="Transaction Permissions" FontWeight="SemiBold" Margin="205,10,0,4" />
                                                        <CheckBox Content="Can Capture First Weight" IsChecked="{Binding OperatorMasterForm.CanCaptureFirstWeight}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Capture Second Weight" IsChecked="{Binding OperatorMasterForm.CanCaptureSecondWeight}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Perform Manual Weight Entry" IsChecked="{Binding OperatorMasterForm.CanPerformManualWeightEntry}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Correct Transactions" IsChecked="{Binding OperatorMasterForm.CanCorrectTransactions}" Margin="205,4,0,0" />
                                                        <CheckBox Content="Can Cancel Transactions" IsChecked="{Binding OperatorMasterForm.CanCancelTransactions}" Margin="205,4,0,0" />
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Header="Status" Margin="4" Padding="8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Last Login" Width="205" /><DatePicker SelectedDate="{Binding OperatorMasterForm.LastLogin, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Status *" Width="205" /><ComboBox IsEditable="True" Text="{Binding OperatorMasterForm.Status, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="Active" /><ComboBoxItem Content="Inactive" /><ComboBoxItem Content="Suspended" /><ComboBoxItem Content="Locked" /></ComboBox></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Effective From *" Width="205" /><DatePicker SelectedDate="{Binding OperatorMasterForm.EffectiveFrom, UpdateSourceTrigger=PropertyChanged}" /></DockPanel>
                                                        <DockPanel Margin="0,2"><Label Content="Remarks" Width="205" /><TextBox Text="{Binding OperatorMasterForm.Remarks, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" /></DockPanel>
                                                    </StackPanel>
                                                </GroupBox>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Reports" Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="4">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                <Button Content="Export CSV" Command="{Binding ExportReportCommand}" MinWidth="105" Height="34" Margin="0,0,8,0" />
                                <Button Content="Print Slip" Command="{Binding PrintSlipCommand}" MinWidth="105" Height="34" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="From Date" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <DatePicker SelectedDate="{Binding ReportFrom}" SelectedDateFormat="Short" Language="en-GB" Width="165" Height="30" FontSize="13" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="To Date" FontWeight="SemiBold" Margin="0,0,0,4" />
