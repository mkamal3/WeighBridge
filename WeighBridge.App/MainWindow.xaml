                                <Button Content="Apply" Command="{Binding LoadTransactionsCommand}" MinWidth="90" Height="34" Margin="0,0,8,0" />
                                <Button Content="Clear" Command="{Binding ClearTransactionFiltersCommand}" MinWidth="90" Height="34" />
                            </StackPanel>
                        </ScrollViewer>
