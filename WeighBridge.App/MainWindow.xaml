                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TransactionStatusFilter, UpdateSourceTrigger=PropertyChanged}" Width="110" Height="30" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                        <Button Content="Apply" Command="{Binding LoadTransactionsCommand}" MinWidth="95" Height="34" Margin="0,0,8,0" />
                                        <Button Content="Clear" Command="{Binding ClearTransactionFiltersCommand}" MinWidth="95" Height="34" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="4">
                        <DataGrid ItemsSource="{Binding FilteredTransactionRows}" SelectedItem="{Binding SelectedTransactionWeighment}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ticket" Binding="{Binding TicketNo}" Width="120" />
                                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="130" />
                                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="110" />
                                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="120" />
                                <DataGridTextColumn Header="Party Account" Binding="{Binding PartyAccount}" Width="120" />
                                <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="160" />
                                <DataGridTextColumn Header="Party Type" Binding="{Binding PartyType}" Width="90" />
                                <DataGridTextColumn Header="Item Number" Binding="{Binding ItemNumber}" Width="120" />
                                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="160" />
                                <DataGridTextColumn Header="First Weight" Binding="{Binding FirstWeight}" Width="100" />
                                <DataGridTextColumn Header="First Time" Binding="{Binding FirstWeightTime}" Width="150" />
                                <DataGridTextColumn Header="First Weight By" Binding="{Binding FirstWeightBy}" Width="130" />
                                <DataGridTextColumn Header="Second Weight" Binding="{Binding SecondWeight}" Width="105" />
                                <DataGridTextColumn Header="Second Time" Binding="{Binding SecondWeightTime}" Width="150" />
                                <DataGridTextColumn Header="Second Weight By" Binding="{Binding SecondWeightBy}" Width="140" />
                                <DataGridTextColumn Header="Net" Binding="{Binding NetWeight}" Width="80" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="12" Width="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <GroupBox Header="Database" Margin="0,0,0,12" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Database Folder Path *" />
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DatabaseFolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: C:\BridgeOne\Database" />
                                        <Button Grid.Column="2" Content="Browse" Click="DatabaseFolderBrowseButton_Click" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Selected Weighbridge" Margin="0,0,0,12" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Weighbridge *" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding ActiveWeighbridgeMasters}"
                                              SelectedItem="{Binding SelectedSettingsWeighbridge}"
                                              DisplayMemberPath="WeighbridgeDisplay"
                                              IsEditable="False" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Device Communication (Read-only from Weighbridge Master)" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Connection Type" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.ConnectionType}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="COM Port" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.ComPort}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="2" Grid.Column="0" Content="Baud Rate" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.BaudRate}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="3" Grid.Column="0" Content="Parity" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Parity}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="4" Grid.Column="0" Content="Data Bits" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.DataBits}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="5" Grid.Column="0" Content="Stop Bits" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.StopBits}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="6" Grid.Column="0" Content="TCP IP / Port" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Text="{Binding Settings.IpAddress}" Width="260" IsReadOnly="True" Background="#EFEFEF" />
                                        <TextBox Text="{Binding Settings.TcpPort}" Width="120" IsReadOnly="True" Background="#EFEFEF" />
                                    </StackPanel>
                                    <Label Grid.Row="7" Grid.Column="0" Content="Weight Stability Time" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.WeightStabilityTime}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="8" Grid.Column="0" Content="Minimum Weight" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.MinimumWeight}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="9" Grid.Column="0" Content="Weight Increment" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.WeightIncrement}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="10" Grid.Column="0" Content="Printer" />
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.Printer}" IsReadOnly="True" Background="#EFEFEF" />
                                </Grid>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                                <TextBlock Text="Maintain communication details in Weighbridge Master. Settings only selects which weighbridge to use." VerticalAlignment="Center" Foreground="Gray" Margin="8,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
