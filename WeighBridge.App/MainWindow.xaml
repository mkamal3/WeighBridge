                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CancellationVoidForm.SubmittedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" IsReadOnly="True" Margin="0,3" Height="30" Background="#F7F8FA" />

                                            <Label Grid.Row="1" Grid.Column="0" Content="Approved/Rejected By" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CancellationVoidForm.ApprovedRejectedBy}" IsReadOnly="True" Margin="0,3,10,3" Height="30" Background="#F7F8FA" />
                                            <Label Grid.Row="1" Grid.Column="2" Content="Approval/Rejected Date/Time" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CancellationVoidForm.ApprovalRejectedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" IsReadOnly="True" Margin="0,3" Height="30" Background="#F7F8FA" />
                                        </Grid>
                                    </GroupBox>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                        <TextBlock Text="When approved, the original Open/Completed transaction is changed to Cancelled and the linked Gate Pass is closed."
                                                   Foreground="#56627A" TextWrapping="Wrap" />
                                    </Border>

                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                            <Button Content="Submit Request"
                                                    Command="{Binding SubmitCancellationVoidCommand}"
                                                    IsEnabled="{Binding CanSubmitCancellationVoid}"
                                                    Visibility="{Binding CanCreateCancellationVoidRequest, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    MinWidth="125" Height="36" Margin="0,0,8,0"
                                                    Style="{StaticResource PrimaryActionButtonStyle}" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Approve"
                                                    Command="{Binding ApproveCancellationVoidCommand}"
                                                    IsEnabled="{Binding CanApproveCancellationVoid}"
                                                    Visibility="{Binding CanApproveRejectCancellationVoidAccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    MinWidth="105" Height="36" Margin="0,0,8,0"
                                                    Style="{StaticResource ApproveActionButtonStyle}" />
                                            <Button Content="Reject"
                                                    Command="{Binding RejectCancellationVoidCommand}"
                                                    IsEnabled="{Binding CanRejectCancellationVoid}"
                                                    Visibility="{Binding CanApproveRejectCancellationVoidAccess, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    MinWidth="105" Height="36"
                                                    Style="{StaticResource RejectActionButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="4" BorderBrush="#E2E7F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Cancellation / Void Requests" FontSize="18" FontWeight="SemiBold" Foreground="#202A44" />
                                    <TextBlock Text="Select a request to review its details and workflow status." Foreground="#667085" Margin="0,3,0,0" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CancellationVoidRequests}" SelectedItem="{Binding SelectedCancellationVoidRequest}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Request No." Binding="{Binding CancellationVoidNumber}" Width="175" />
                                        <DataGridTextColumn Header="Slip Number" Binding="{Binding SlipNumber}" Width="145" />
                                        <DataGridTextColumn Header="Gate Pass" Binding="{Binding GatePassNumber}" Width="125" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="85" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="150" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                        <DataGridTextColumn Header="Submitted By" Binding="{Binding SubmittedBy}" Width="115" />
                                        <DataGridTextColumn Header="Submitted Date/Time" Binding="{Binding SubmittedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" />
                                        <DataGridTextColumn Header="Approved/Rejected By" Binding="{Binding ApprovedRejectedBy}" Width="145" />
                                        <DataGridTextColumn Header="Approval/Rejected Date/Time" Binding="{Binding ApprovalRejectedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="165" />
                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Correction"
                     DataContext="{Binding CorrectionWorkspace}"
                     Visibility="{Binding DataContext.CanAccessCorrection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="14" Margin="4,4,4,8" BorderBrush="#E2E7F0" BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="+ New Correction"
                                    Command="{Binding NewRequestCommand}"
                                    Visibility="{Binding CanCreateRequest, Converter={StaticResource BoolToVisibilityConverter}}"
                                    MinWidth="135" Height="34"
                                    Background="#202A44" Foreground="White" BorderBrush="#202A44"
                                    FontWeight="SemiBold" />
                            <StackPanel>
                                <TextBlock Text="Transaction Correction Management" FontSize="21" FontWeight="SemiBold" Foreground="#202A44" />
                                <TextBlock Text="Create, review and approve corrections for Completed weighbridge transactions. Original values remain available in correction history."
                                           Foreground="#667085" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="920" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" BorderBrush="#E2E7F0" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Request Details" FontSize="18" FontWeight="SemiBold" Foreground="#202A44" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right" Background="#EEF3FF" CornerRadius="12" Padding="12,4">
                                            <TextBlock Text="{Binding CorrectionForm.Status}" Foreground="#314A7D" FontWeight="SemiBold" />
                                        </Border>
                                    </DockPanel>

                                    <GroupBox Header="Original Transaction" Margin="0,0,0,10" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="145" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label Grid.Column="0" Content="Slip Number *" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Margin="0,3,14,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding CorrectionForm.SlipNumber}" IsReadOnly="True" Height="30" Background="#F7F8FA" />
                                                <Button Grid.Column="1" Content="🔍" Command="{Binding OpenSlipLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsDraftEditable}" ToolTip="Select Completed transaction" />
                                            </Grid>
                                            <Label Grid.Column="2" Content="Current Version" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{Binding OriginalWeighment.CorrectionVersion}" IsReadOnly="True" Margin="0,3" Height="30" Background="#F7F8FA" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Correction Details" Margin="0,0,0,10" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="135" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Label Grid.Row="0" Grid.Column="0" Content="Correction Number" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CorrectionForm.CorrectionNumber}" IsReadOnly="True" Margin="0,3,14,3" Height="30" Background="#F7F8FA" />
                                            <Label Grid.Row="0" Grid.Column="2" Content="Type *" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding CorrectionTypes}" SelectedItem="{Binding CorrectionForm.CorrectionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDraftEditable}" Margin="0,3" Height="30" />

                                            <Label Grid.Row="1" Grid.Column="0" Content="Reason *" VerticalAlignment="Center" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CorrectionReasons}" DisplayMemberPath="DisplayText" SelectedValuePath="Code" SelectedValue="{Binding CorrectionForm.Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDraftEditable}" Margin="0,3,14,3" Height="30" />
                                            <Label Grid.Row="1" Grid.Column="2" Content="Comment *" VerticalAlignment="Top" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CorrectionForm.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Margin="0,3" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="Values to Correct" Margin="0,0,0,10" Padding="8">
                                        <TabControl MinHeight="320">
                                            <TabItem Header="Header Correction">
                                                <Grid Margin="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="165" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Original Value" FontWeight="SemiBold" Foreground="#667085" Margin="4,2,4,7" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Corrected Value" FontWeight="SemiBold" Foreground="#202A44" Margin="4,2,4,7" />

                                                    <Label Grid.Row="1" Grid.Column="0" Content="Vehicle No" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OriginalWeighment.VehicleNo}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CorrectedWeighment.VehicleNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Margin="3" />

                                                    <Label Grid.Row="2" Grid.Column="0" Content="Driver Name" />
                                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OriginalWeighment.DriverName}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />
                                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding CorrectedWeighment.DriverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Margin="3" />


                                                    <Label Grid.Row="3" Grid.Column="0" Content="First Weight" />
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OriginalWeighment.FirstWeight}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />
                                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding CorrectedFirstWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsWeightReadOnly}" Margin="3" />

                                                    <Label Grid.Row="4" Grid.Column="0" Content="Second Weight" />
                                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OriginalWeighment.SecondWeight}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />
                                                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CorrectedSecondWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" IsReadOnly="{Binding IsWeightReadOnly}" Margin="3" />

                                                    <Label Grid.Row="5" Grid.Column="0" Content="Net Weight" />
                                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OriginalWeighment.NetWeight}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />
                                                    <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding CorrectedNetWeight, Mode=OneWay}" IsReadOnly="True" Background="#F2F4F7" Margin="3" />

                                                    <Label Grid.Row="6" Grid.Column="0" Content="Remarks" VerticalAlignment="Top" />
                                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OriginalWeighment.Remarks}" IsReadOnly="True" Background="#F2F4F7" Margin="3" Height="54" AcceptsReturn="True" TextWrapping="Wrap" />
                                                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding CorrectedWeighment.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormReadOnly}" Margin="3" Height="54" AcceptsReturn="True" TextWrapping="Wrap" />
                                                </Grid>
                                            </TabItem>

                                            <TabItem Header="Material Line Correction">
                                                <Grid Margin="8">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                        <TextBlock DockPanel.Dock="Left" Text="Add, modify/replace, or remove material lines. Original line values remain in audit history." Foreground="#667085" VerticalAlignment="Center" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                            <Button Content="Add Line" Command="{Binding AddLineCommand}" IsEnabled="{Binding IsDraftEditable}" Width="92" Height="30" />
                                                            <Button Content="Remove Added Line" Command="{Binding RemoveAddedLineCommand}" IsEnabled="{Binding CanRemoveAddedLine}" Width="132" Height="30" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <DataGrid Grid.Row="1" ItemsSource="{Binding MaterialLines}" SelectedItem="{Binding SelectedMaterialLine, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="{Binding IsFormReadOnly}" CanUserAddRows="False" MinHeight="230">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Line" Binding="{Binding LineNo}" Width="50" IsReadOnly="True" />
                                                            <DataGridTextColumn Header="Original Item" Binding="{Binding OriginalItemNumber}" Width="105" IsReadOnly="True" />
                                                            <DataGridTextColumn Header="Original UOM" Binding="{Binding OriginalUom}" Width="85" IsReadOnly="True" />
                                                            <DataGridTextColumn Header="Original Qty" Binding="{Binding OriginalExpectedQty}" Width="90" IsReadOnly="True" />
                                                            <DataGridTemplateColumn Header="Action" Width="95">
                                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.LineActionTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="Corrected Item" Width="125">
                                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.ItemMasters, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="ItemNumber" SelectedValuePath="ItemNumber" SelectedValue="{Binding CorrectedItemNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Header="Corrected UOM" Width="105">
                                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                                    <ComboBox ItemsSource="{Binding DataContext.UomSymbols, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding CorrectedUom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsDraftEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="Corrected Qty" Binding="{Binding CorrectedExpectedQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="105" />
                                                            <DataGridTextColumn Header="Corrected Remarks" Binding="{Binding CorrectedRemarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </Grid>
                                            </TabItem>
                                        </TabControl>
                                    </GroupBox>

                                    <GroupBox Header="Workflow History" Margin="0,0,0,10" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="165" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Content="Submitted By" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CorrectionForm.SubmittedBy}" IsReadOnly="True" Margin="0,3,10,3" Height="30" Background="#F7F8FA" />
                                            <Label Grid.Row="0" Grid.Column="2" Content="Submitted Date/Time" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CorrectionForm.SubmittedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" IsReadOnly="True" Margin="0,3" Height="30" Background="#F7F8FA" />
                                            <Label Grid.Row="1" Grid.Column="0" Content="Approved/Rejected By" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CorrectionForm.ApprovedRejectedBy}" IsReadOnly="True" Margin="0,3,10,3" Height="30" Background="#F7F8FA" />
                                            <Label Grid.Row="1" Grid.Column="2" Content="Approval/Rejected Date/Time" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding CorrectionForm.ApprovalRejectedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" IsReadOnly="True" Margin="0,3" Height="30" Background="#F7F8FA" />
                                        </Grid>
                                    </GroupBox>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                        <TextBlock Text="On approval, corrected values become the active transaction values. Original header and material-line values remain in correction history." Foreground="#56627A" TextWrapping="Wrap" />
                                    </Border>

                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Left" Content="Submit Request" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" MinWidth="120" Height="36" Style="{StaticResource PrimaryActionButtonStyle}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Approve" Command="{Binding ApproveCommand}" IsEnabled="{Binding CanApprove}" MinWidth="105" Height="36" Style="{StaticResource ApproveActionButtonStyle}" />
                                            <Button Content="Reject" Command="{Binding RejectCommand}" IsEnabled="{Binding CanReject}" MinWidth="105" Height="36" Style="{StaticResource RejectActionButtonStyle}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#314A7D" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="4" BorderBrush="#E2E7F0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Correction Requests" FontSize="18" FontWeight="SemiBold" Foreground="#202A44" />
                                        <TextBlock Text="Select a request to review its header, material-line changes and workflow status." Foreground="#667085" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Width="90" Height="32" />
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Correction No." Binding="{Binding CorrectionNumber}" Width="180" />
                                        <DataGridTextColumn Header="Slip Number" Binding="{Binding SlipNumber}" Width="150" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding CorrectionType}" Width="105" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="135" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                                        <DataGridTextColumn Header="Submitted By" Binding="{Binding SubmittedBy}" Width="110" />
                                        <DataGridTextColumn Header="Submitted Date/Time" Binding="{Binding SubmittedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="145" />
                                        <DataGridTextColumn Header="Approved/Rejected By" Binding="{Binding ApprovedRejectedBy}" Width="145" />
                                        <DataGridTextColumn Header="Approval/Rejection Date" Binding="{Binding ApprovalRejectedDateTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="155" />
                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="200" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings" Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer>
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="12" Width="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <GroupBox Header="Database" Margin="0,0,0,12" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Database Folder Path *" />
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DatabaseFolderPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: C:\BridgeOne\Database" />
                                        <Button Grid.Column="2" Content="Browse" Click="DatabaseFolderBrowseButton_Click" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Selected Weighbridge" Margin="0,0,0,12" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="Weighbridge *" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding ActiveWeighbridgeMasters}"
                                              SelectedItem="{Binding SelectedSettingsWeighbridge}"
                                              DisplayMemberPath="WeighbridgeDisplay"
                                              IsEditable="False" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Device Communication (Read-only from Weighbridge Master)" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Connection Type" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.ConnectionType}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="COM Port" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.ComPort}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="2" Grid.Column="0" Content="Baud Rate" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.BaudRate}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="3" Grid.Column="0" Content="Parity" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.Parity}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="4" Grid.Column="0" Content="Data Bits" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.DataBits}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="5" Grid.Column="0" Content="Stop Bits" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.StopBits}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="6" Grid.Column="0" Content="TCP IP / Port" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Text="{Binding Settings.IpAddress}" Width="260" IsReadOnly="True" Background="#EFEFEF" />
                                        <TextBox Text="{Binding Settings.TcpPort}" Width="120" IsReadOnly="True" Background="#EFEFEF" />
                                    </StackPanel>
                                    <Label Grid.Row="7" Grid.Column="0" Content="Weight Stability Time" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.WeightStabilityTime}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="8" Grid.Column="0" Content="Minimum Weight" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.MinimumWeight}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="9" Grid.Column="0" Content="Weight Increment" />
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.WeightIncrement}" IsReadOnly="True" Background="#EFEFEF" />
                                    <Label Grid.Row="10" Grid.Column="0" Content="Printer" />
                                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.Printer}" IsReadOnly="True" Background="#EFEFEF" />
                                </Grid>
                            </GroupBox>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" />
                                <TextBlock Text="Maintain communication details in Weighbridge Master. Settings only selects which weighbridge to use." VerticalAlignment="Center" Foreground="Gray" Margin="8,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
