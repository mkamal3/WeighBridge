                                        <TextBlock Text="Company" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding TransactionCompanyFilter, UpdateSourceTrigger=PropertyChanged}" Width="135" Height="30" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,0">
