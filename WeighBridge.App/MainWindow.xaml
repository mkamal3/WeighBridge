<Window x:Class="WeightBridgeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BridgeOne" Height="800" Width="1240"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="LookupIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#202A44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Lookup" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <Style x:Key="GridIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="#202A44" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202A44" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="BridgeOne" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Operator: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Connection: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Legal Entity: " Foreground="#D8DFEA" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AllowedLegalEntities}"
                              SelectedValuePath="DataAreaId"
                              DisplayMemberPath="DataAreaId"
                              SelectedValue="{Binding SelectedLegalEntityDataAreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="95" Height="24" Margin="0,0,16,0"
                              ToolTip="Switch between assigned Legal Entities" />
                    <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Refresh" />
                    <Button Click="LogoutButton_Click" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Logout">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                      Data="M10,4 L6,4 C4.9,4 4,4.9 4,6 L4,18 C4,19.1 4.9,20 6,20 L10,20 M13,8 L17,12 L13,16 M8,12 L17,12" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Content="✕" Click="CloseButton_Click" Style="{StaticResource HeaderIconButtonStyle}" ToolTip="Close" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EF" BorderThickness="0,0,0,1" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" Foreground="#202A44" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
        </Border>

        <TabControl Grid.Row="2" Margin="10,6,10,10" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
            <TabItem Header="Weighment" Visibility="{Binding CanAccessWeighment, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Weighment Header Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Slip Number" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SlipNumber}" IsReadOnly="True" Background="#EFEFEF" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Legal Entity *" />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CurrentUserCompany, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />

                            <Label Grid.Row="3" Grid.Column="0" Content="Transaction Type *" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TransactionTypeDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="3" Grid.Column="2" Content="🔍" Command="{Binding OpenTransactionTypeLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsHeaderAndLinesEditable}" ToolTip="Select Transaction Type" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Scenario *" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ScenarioDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="4" Grid.Column="2" Content="🔍" Command="{Binding OpenScenarioLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsHeaderAndLinesEditable}" ToolTip="Select Scenario" />

                            <Label Grid.Row="5" Grid.Column="0" Content="Gate Pass No" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding GatePassNumber, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="5" Grid.Column="2" Content="🔍" Command="{Binding OpenWeighmentGatePassLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsHeaderAndLinesEditable}" ToolTip="Select Open Gate Pass" />

                            <Label Grid.Row="6" Grid.Column="0" Content="Vehicle No *" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding VehicleNo, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="6" Grid.Column="2" Content="🔍" Command="{Binding OpenVehicleLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsHeaderAndLinesEditable}" ToolTip="Select Vehicle" />

                            <Label Grid.Row="7" Grid.Column="0" Content="Driver Name *" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DriverName, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="7" Grid.Column="2" Content="🔍" Command="{Binding OpenDriverLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsHeaderAndLinesEditable}" ToolTip="Select Driver" />


                            <Label Grid.Row="8" Grid.Column="0" Content="External Ref" />
                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsHeaderAndLinesEditable}" />

                            <Label Grid.Row="9" Grid.Column="0" Content="Operator Remarks" />
                            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OperatorRemarks, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap" IsEnabled="{Binding IsHeaderAndLinesEditable}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350" Visibility="{Binding IsPurchaseReceiptCollectionForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Purchase / Receipt / Collection Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Purchase Subtype *" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PurchaseDetailsForm.PurchaseSubtype, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseDetailsEditable}" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Vendor" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PurchaseVendorDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="2" Grid.Column="2" Content="🔍" Command="{Binding OpenPurchaseVendorLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsPurchaseVendorSelectable}" ToolTip="Select Vendor" />

                            <Label Grid.Row="3" Grid.Column="0" Content="Walk-in Vendor" />
                            <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding PurchaseDetailsForm.WalkInVendor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseDetailsEditable}" VerticalAlignment="Center" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Supplier / Driver Name" />
                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PurchaseDetailsForm.SupplierDriverName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseDetailsEditable}" />

                            <Label Grid.Row="5" Grid.Column="0" Content="Purchase / Contract Ref" />
                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PurchaseDetailsForm.PurchaseContractReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseDetailsEditable}" />

                            <Label Grid.Row="6" Grid.Column="0" Content="Source *" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PurchaseSourceDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="6" Grid.Column="2" Content="🔍" Command="{Binding OpenPurchaseSourceLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsPurchaseDetailsEditable}" ToolTip="Select Source" />

                            <Label Grid.Row="7" Grid.Column="0" Content="Destination *" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding PurchaseDestinationDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="7" Grid.Column="2" Content="🔍" Command="{Binding OpenPurchaseDestinationLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsPurchaseDetailsEditable}" ToolTip="Select Destination" />

                            <Label Grid.Row="8" Grid.Column="0" Content="FOC Flag" />
                            <CheckBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding PurchaseDetailsForm.FocFlag, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseDetailsEditable}" VerticalAlignment="Center" />

                            <Label Grid.Row="9" Grid.Column="0" Content="Rate / Amount" />
                            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PurchaseDetailsForm.RateAmount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPurchaseRateAmountEditable}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350" Visibility="{Binding IsContractCollectionForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="155" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Contract Collection Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Label Grid.Row="1" Grid.Column="0" Content="Vendor Account *" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ContractCollectionVendorDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="1" Grid.Column="2" Content="🔍" Command="{Binding OpenContractCollectionVendorLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsContractCollectionDetailsEditable}" ToolTip="Select Vendor Account" />

                            <Label Grid.Row="2" Grid.Column="0" Content="Invoice Account" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ContractCollectionInvoiceAccountDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="2" Grid.Column="2" Content="🔍" Command="{Binding OpenContractCollectionInvoiceAccountLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsContractCollectionDetailsEditable}" ToolTip="Select Invoice Account" />

                            <Label Grid.Row="3" Grid.Column="0" Content="Contract Number *" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ContractCollectionContractDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="3" Grid.Column="2" Content="🔍" Command="{Binding OpenContractCollectionContractLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsContractCollectionDetailsEditable}" ToolTip="Select Contract" />

                            <Label Grid.Row="4" Grid.Column="0" Content="Collection Location *" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ContractCollectionLocationDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="4" Grid.Column="2" Content="🔍" Command="{Binding OpenContractCollectionLocationLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsContractCollectionDetailsEditable}" ToolTip="Select Collection Location" />

                            <Label Grid.Row="5" Grid.Column="0" Content="Destination *" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ContractCollectionDestinationDisplay, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                            <Button Grid.Row="5" Grid.Column="2" Content="🔍" Command="{Binding OpenContractCollectionDestinationLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsContractCollectionDetailsEditable}" ToolTip="Select Destination" />

                            <Label Grid.Row="6" Grid.Column="0" Content="Billing Basis" />
                            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ContractCollectionDetailsForm.BillingBasis, Mode=OneWay}" IsReadOnly="True" Background="#EFEFEF" />
                        </Grid>
                    </Border>


                    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350" Visibility="{Binding IsTransferForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Transfer Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Label Grid.Row="1" Grid.Column="0" Content="Transfer Direction *" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding TransferDirectionValues}" SelectedItem="{Binding TransferDetailsForm.TransferDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="2" Grid.Column="0" Content="From Legal Entity *" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding LegalEntities}" DisplayMemberPath="DataAreaId" SelectedValuePath="DataAreaId" SelectedValue="{Binding TransferDetailsForm.FromLegalEntity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="3" Grid.Column="0" Content="To Legal Entity *" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding LegalEntities}" DisplayMemberPath="DataAreaId" SelectedValuePath="DataAreaId" SelectedValue="{Binding TransferDetailsForm.ToLegalEntity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="4" Grid.Column="0" Content="From Location *" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TransferDetailsForm.FromLocation}" IsReadOnly="True" Background="#EFEFEF" />
                                <Button Grid.Row="4" Grid.Column="2" Content="🔍" Command="{Binding OpenTransferFromLocationLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="5" Grid.Column="0" Content="To Location *" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TransferDetailsForm.ToLocation}" IsReadOnly="True" Background="#EFEFEF" />
                                <Button Grid.Row="5" Grid.Column="2" Content="🔍" Command="{Binding OpenTransferToLocationLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="6" Grid.Column="0" Content="Transfer Reference" />
                                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TransferDetailsForm.TransferReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                                <Label Grid.Row="7" Grid.Column="0" Content="Sending Slip Ref" />
                                <ComboBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding CompletedToday}" DisplayMemberPath="SlipNumber" IsEditable="True" Text="{Binding TransferDetailsForm.SendingSlipReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsTransferDetailsEditable}" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350" Visibility="{Binding IsSalesDispatchForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Sales / Dispatch Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Label Grid.Row="1" Grid.Column="0" Content="Sales Subtype *" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding SalesSubtypeValues}" SelectedItem="{Binding SalesDispatchDetailsForm.SalesSubtype, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="2" Grid.Column="0" Content="Customer" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SalesDispatchDetailsForm.CustomerAccount}" IsReadOnly="True" Background="#EFEFEF" ToolTip="{Binding SalesDispatchDetailsForm.CustomerName}" />
                                <Button Grid.Row="2" Grid.Column="2" Content="🔍" Command="{Binding OpenSalesCustomerLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="3" Grid.Column="0" Content="Walk-in Customer" />
                                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SalesDispatchDetailsForm.WalkInCustomer, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="4" Grid.Column="0" Content="Sales Reference" />
                                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SalesDispatchDetailsForm.SalesReference, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="5" Grid.Column="0" Content="Source *" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SalesDispatchDetailsForm.Source}" IsReadOnly="True" Background="#EFEFEF" />
                                <Button Grid.Row="5" Grid.Column="2" Content="🔍" Command="{Binding OpenSalesSourceLookupCommand}" Style="{StaticResource LookupIconButtonStyle}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="6" Grid.Column="0" Content="Destination" />
                                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SalesDispatchDetailsForm.Destination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="7" Grid.Column="0" Content="Payment Status" />
                                <ComboBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding PaymentStatusValues}" SelectedItem="{Binding SalesDispatchDetailsForm.PaymentStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                                <Label Grid.Row="8" Grid.Column="0" Content="Receipt Number" />
                                <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SalesDispatchDetailsForm.ReceiptNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsSalesDispatchDetailsEditable}" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="14" Margin="4" MinHeight="350" Visibility="{Binding IsProductionWeighingForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="165" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Production Weighing Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <Label Grid.Row="1" Grid.Column="0" Content="Production Movement *" />
