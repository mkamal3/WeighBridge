                                                <DataGridTextColumn Header="Expected Qty" Binding="{Binding ExpectedQty}" Width="95" />
                                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
